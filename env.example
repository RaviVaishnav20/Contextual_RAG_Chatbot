# Environment Configuration
# Copy this file to .env and update the values as needed

# Environment selection (affects which config from database.yaml is used)
# Options: default, development, production, docker
ENVIRONMENT=default

# Direct PostgreSQL DSN override (optional)
# If set, this will override the configuration from database.yaml
# POSTGRES_DSN=postgresql+psycopg://username:password@host:port/database?sslmode=prefer

# Database configuration (used when ENVIRONMENT=production)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=vector_db
DATABASE_USER=ravi
DATABASE_PASSWORD=password
DATABASE_TABLE_NAME=contextual_embedding

# Model configurations
EMBED_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
